# ==========================================
# TestHub Root .gitignore
# ==========================================

# Environment & Secrets (CRITICAL: Do NOT commit secrets!)
.env
.env.*
!.env.example
!*.env.example
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Operating System & Cache
.DS_Store
Thumbs.db
*.tmp
*.swp
*.swo
*~
.cache/
.codegraph/

# IDE & Editor files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace

# ------------------------------------------
# Backend (Go) Artifacts
# ------------------------------------------
# Compiled Binaries
backend/bin/
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test & Coverage Outputs
*.test
*.out
coverage.out
profile.out

# Go build cache
backend/.golangci.cache/

# ------------------------------------------
# Frontend (React + Vite + Node/Bun)
# ------------------------------------------
# Dependencies
node_modules/
frontend/node_modules/

# Production build outputs
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/

# Package manager debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun-debug.log*

# ------------------------------------------
# Database & Persistent Volumes
# ------------------------------------------
postgres_data/
redis_data/
*.rdb
*.sql.gz
*.dump
*.sqlite
*.sqlite3

# ------------------------------------------
# User Uploads
# ------------------------------------------
uploads/*
!uploads/.gitkeep
!uploads/**/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/**/.gitkeep
