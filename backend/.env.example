# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=testhub
DB_POOL_SIZE=20
DB_MAX_IDLE_CONNS=5
DB_SSL_MODE=disable

# Redis
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=testhub-super-secret-jwt-key-production-ready-min-32-chars
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=168h

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=debug
DOMAIN=localhost

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
