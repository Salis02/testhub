# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=testhub
DB_POOL_SIZE=20
DB_MAX_IDLE_CONNS=5
DB_SSL_MODE=disable

# Redis
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=testhub-super-secret-jwt-key-production-ready-min-32-chars
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=168h

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=debug
DOMAIN=localhost

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# ==============================================================================
# AI MULTI-PROVIDER & MULTI-KEY ROTATION
# ==============================================================================
# Anda bisa memasukkan satu atau lebih API key (pisahkan dengan koma jika lebih dari satu)
# Jika key 1 limit (HTTP 429), server otomatis beralih ke key berikutnya.

# 1. Google Gemini (Dapatkan gratis di https://aistudio.google.com/app/apikey)
# Contoh: GEMINI_API_KEYS=AIzaSyA...,AIzaSyB...
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq (Dapatkan gratis di https://console.groq.com/keys)
# Contoh: GROQ_API_KEYS=gsk_xxx1,gsk_xxx2
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# GOOGLE OAUTH / SIGN-IN
# ==============================================================================
# Google Cloud Console OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

